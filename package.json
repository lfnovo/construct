{
  "name": "construct",
  "private": true,
  "version": "0.1.4",
  "description": "A local-first desktop knowledge workspace for coding agents",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lfnovo/construct.git"
  },
  "homepage": "https://github.com/lfnovo/construct",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite --host 127.0.0.1 --port 1420",
    "build": "tauri build --bundles app",
    "build:web": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "check:docs": "node scripts/check-docs.mjs",
    "lint": "npm run lint:web && npm run lint:rust",
    "lint:web": "eslint src tests scripts vite.config.ts",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "format:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "test": "npm run check && npm run test:web && npm run test:rust",
    "test:web": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:mcp": "node scripts/mcp-smoke.mjs",
    "release:check": "node scripts/check-release-version.mjs",
    "validate": "npm run check:docs && npm run lint && npm run test && npm run format:check && npm run build:web"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.3.3",
    "@codemirror/language": "^6.11.0",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.36.5",
    "@milkdown/crepe": "^7.21.3",
    "@tauri-apps/api": "^2.6.0",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.27.0",
    "mermaid": "^11.6.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.0.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.2.0"
  }
}
